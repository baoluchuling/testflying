[Unit]
Description=Standalone Testflying Store API
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=testflying-store
Group=testflying-store
WorkingDirectory=/var/lib/testflying-store-api
EnvironmentFile=/etc/testflying-store-api/service.env
ExecStart=/opt/testflying-store-api/current/bin/store-api
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StateDirectory=testflying-store-api
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/testflying-store-api
LimitNOFILE=8192
MemoryMax=512M
TasksMax=128

[Install]
WantedBy=multi-user.target
